# Copy this file to ".env" and fill in the real values.
# ".env" holds secrets and must NEVER be pushed to GitHub.

PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (URI)
# Replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (used from Sprint 3). Gmail account + App Password.
SMTP_USER=changetrack.demo@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password

# Reminder emails (checked every hour). Set to false to switch them off.
REMINDERS_ENABLED=true
