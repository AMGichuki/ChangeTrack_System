{
  "name": "changetrack-server",
  "version": "1.0.0",
  "description": "ChangeTrack API (Express, MVC)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test-logins": "node scripts/createTestLogins.js",
    "sample-evidence": "node scripts/uploadSampleEvidence.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:all": "npm test && npm run test:integration",
    "test-email": "node scripts/sendTestEmail.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/functions": "^3.11.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "0.17.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
